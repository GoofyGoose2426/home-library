# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Supabase → Project Settings → API (Data API) → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase → Project Settings → API Keys → Publishable key (starts with sb_publishable_)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# The only email allowed to sign in
OWNER_EMAIL=owner@example.com

# Any long random string. Vercel sends it with the daily keep-alive call.
CRON_SECRET=make-up-a-long-random-string

# Optional. Google Books → Google Cloud console → APIs & Services → Credentials →
# API key, restricted to the Books API. Without it, Fill in details uses
# Open Library only.
GOOGLE_BOOKS_API_KEY=
